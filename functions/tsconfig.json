{
  "compilerOptions": {
    "moduleResolution": "node16",
    "module": "node16",
    "noImplicitReturns": true,
    "noUnusedLocals": true,
    "allowSyntheticDefaultImports": true,
    "outDir": "lib",
    "rootDir": "..",
    "sourceMap": true,
    "strict": true,
    "target": "es2021",
    "skipLibCheck": true,
    "esModuleInterop": true
  },
  "compileOnSave": true,
  "include": [
    "src/**/*.ts",
    "../shared/dice/endSessionScoreboard.ts",
    "../types/models.ts"
  ]
}
